{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.sandbox-runner"
  },
  "deploy": {
    "startCommand": "node dist/sandbox/runner/main.js",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 60,
    "numReplicas": 1
  }
}
