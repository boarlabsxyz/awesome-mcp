{
  "name": "google-docs-mcp-e2e",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "node --import tsx --test --test-concurrency=1 tests/*.smoke.ts",
    "test:tasks": "node --import tsx --test --test-concurrency=1 tests/tasks/*.task.ts",
    "test:unit": "node --import tsx --test tests/unit/*.unit.ts",
    "check": "node --import tsx --test tests/tools/*/*.check.ts",
    "check:needle": "node --import tsx --test tests/tools/needle/*.check.ts",
    "check:volume": "node --import tsx --test tests/tools/volume/*.check.ts",
    "check:zero": "node --import tsx --test tests/tools/zero/*.check.ts",
    "check:auth": "node --import tsx scripts/checkAuth.ts",
    "sweep:sandbox": "node --import tsx scripts/sweepSandbox.ts",
    "seed:account": "node --import tsx scripts/seedAccount.ts",
    "seed:browserbase": "node --import tsx scripts/seedBrowserbaseContext.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@browserbasehq/sdk": "^2.19.0",
    "playwright": "^1.49.0",
    "webdriverio": "^9.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
