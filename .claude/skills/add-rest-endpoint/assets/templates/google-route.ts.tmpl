  // GET {{catalogPath}} - {{summary}}
  // Mirrors the MCP tool `{{mcpToolName}}`. Returns raw upstream JSON.
  // {{#staticSiblingNote}}Registered BEFORE /api/v1/{{service}}/:{{paramName}} so Express
  // matches this static path first.{{/staticSiblingNote}}
  app.get('{{expressPath}}', {{authMiddleware}}, async (req: ApiAuthenticatedRequest, res) => {
    try {
      const {{paramName}} = req.params.{{paramName}} as string;
      {{queryParams}}

      const {{client}} = req.userSession!.{{sessionClient}};
      const response = await {{client}}.{{sdkCall}}({
        {{sdkArgs}}
        fields: '{{fieldMask}}',
      });

      res.json(response.data);
    } catch (err) {
      console.error('Error in {{mcpToolName}} REST handler:', err);
      sendUpstreamError(res, err, { notFound: '{{ResourceName}} not found', fallback: 'Failed to {{verbPhrase}}' });
    }
  });

