  // POST {{catalogPath}} - {{summary}}
  // Mirrors the MCP tool `{{mcpToolName}}`. Body is validated with that tool's
  // own Zod schema so the REST and MCP surfaces cannot drift.
  // {{#largeBodyNote}}Bodies on this path are parsed with the {{bodyLimit}} limit from
  // REST_LARGE_BODY_PREFIXES, not the global 100 kb — see the note below.{{/largeBodyNote}}
  app.post('{{expressPath}}', {{authMiddleware}}, async (req: ApiAuthenticatedRequest, res) => {
    try {
      // Reuse the MCP tool's schema. If it is still inline in the addTool call,
      // lift it to `export const {{SchemaName}} = z.object({...})` in
      // src/{{provider}}/server.ts and reference it from both places.
      //
      // Path params are merged OVER the body so a URL and a mismatched body key
      // cannot disagree about which record is being written.
      const { {{SchemaName}} } = await import('../{{provider}}/server.js');
      const parsed = {{SchemaName}}.safeParse({ ...req.body, {{paramName}}: req.params.{{paramName}} });
      if (!parsed.success) {
        res.status(400).json({ error: 'Invalid request body', issues: parsed.error.flatten() });
        return;
      }

      // Call the tool's exported op rather than rebuilding the request here —
      // a second copy of the request-building drifts from the tool. See
      // "Extract the op, not just the schema" in references/write-endpoints.md.
      const { {{performOp}} } = await import('../{{provider}}/server.js');
      const result = await {{performOp}}(req.userSession!.{{sessionClient}}, parsed.data);

      // 201 + the created resource (callers chaining curls need the new id).
      // Use 200 for updates and appends.
      res.status(201).json({{projection}});
    } catch (err: any) {
      console.error('Error in {{mcpToolName}} REST handler:', err);
      // If the op raises a provider UserError for genuinely bad input, answer 400
      // ONLY when no upstream status survived — those helpers also wrap the
      // provider's own 404s and 403s. See references/write-endpoints.md.
      if (err?.name === 'UserError' && typeof err?.code !== 'number') {
        res.status(400).json({ error: err.message });
        return;
      }
      sendUpstreamError(res, err, { notFound: '{{ResourceName}} not found', fallback: 'Failed to {{verbPhrase}}' });
    }
  });

// ---------------------------------------------------------------------------
// Before using this template
//
// 1. One-time prerequisites must be done (first POST endpoint only):
//    - src/restCatalog.ts            method: 'GET' | 'POST'
//    - restCatalog.test.ts           relax the GET-only assertion to a union
//    - restRoutes.auth.test.ts       add NEW_REST_WRITE_ENDPOINTS + POST loop
//    - listRestEndpoints.ts          update the read-only framing in the description
//    See references/write-endpoints.md.
//
// 2. Justify the endpoint: large request body, or a shell pipeline that would
//    otherwise round-trip through the LLM. A small update belongs in the MCP
//    tool, where it keeps Zod validation and the destructiveHint annotation.
//
// 3. A destructiveHint: true tool needs explicit user sign-off, an action path
//    (/{id}/archive, not DELETE /{id}), and a warning in the catalog `notes`.
//
// 4. A large body needs its path prefix added to REST_LARGE_BODY_PREFIXES in
//    registerSharedRoutes. Do NOT mount express.json({ limit }) next to the
//    handler — the global parser has already read (and 413'd) the body by then,
//    so a per-route parser never runs. Then assert it: post >100 kb and expect
//    validation, not 413.
//
// Placeholders
//   {{SchemaName}}       exported Zod schema, e.g. appendSpreadsheetRowsSchema
//   {{performOp}}        exported op, e.g. performCreateSpreadsheet. Drop this
//                        line only when the tool body is a single client call
//                        the route can make directly.
//   {{projection}}       `result` for raw upstream JSON, or the tool's exported
//                        projection (e.g. projectEvent(result)) when one exists
//                        — never a second inline copy of the response shape.
//   {{authMiddleware}}   requireSheetsApiKey | requireClickUpApiKey | ...
//   {{sessionClient}}    googleSheets | googleDocs | ... (Google), or build a
//                        third-party client: const { XClient } = await
//                        import('../{{provider}}/apiHelpers.js');
//
// `express` and `sendUpstreamError` are already imported in webServer.ts, and
// the express.raw() routes mounted ahead of the global express.json() must stay
// undisturbed.
// ---------------------------------------------------------------------------
