  // POST {{catalogPath}} - {{summary}}
  // Mirrors the MCP tool `{{mcpToolName}}`. Body is validated with that tool's
  // own Zod schema so the REST and MCP surfaces cannot drift.
  // {{#largeBodyNote}}Body limit raised to {{bodyLimit}} — this endpoint exists to accept
  // large payloads that would otherwise cross the LLM context window.{{/largeBodyNote}}
  app.post(
    '{{expressPath}}',
    express.json({ limit: '{{bodyLimit}}' }),
    {{authMiddleware}},
    async (req: ApiAuthenticatedRequest, res) => {
      try {
        const {{paramName}} = req.params.{{paramName}} as string;

        // Reuse the MCP tool's schema. If it is still inline in the addTool
        // call, lift it to `export const {{SchemaName}} = z.object({...})` in
        // src/{{provider}}/server.ts and reference it from both places.
        const { {{SchemaName}} } = await import('../{{provider}}/server.js');
        const parsed = {{SchemaName}}.safeParse(req.body);
        if (!parsed.success) {
          res.status(400).json({ error: 'Invalid request body', issues: parsed.error.flatten() });
          return;
        }
        const args = parsed.data;

        const {{client}} = req.userSession!.{{sessionClient}};
        const response = await {{client}}.{{sdkCall}}({
          {{sdkArgs}}
        });

        // 201 + the created resource (callers chaining curls need the new id).
        // Use 200 for updates and appends.
        res.status(201).json(response.data);
      } catch (err) {
        console.error('Error in {{mcpToolName}} REST handler:', err);
        sendUpstreamError(res, err, { notFound: '{{ResourceName}} not found', fallback: 'Failed to {{verbPhrase}}' });
      }
    },
  );

