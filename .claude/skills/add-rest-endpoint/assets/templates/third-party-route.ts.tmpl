  // GET {{catalogPath}} - {{summary}}
  // Mirrors the MCP tool `{{mcpToolName}}`. Returns raw upstream JSON.
  app.get('{{expressPath}}', {{authMiddleware}}, async (req: ApiAuthenticatedRequest, res) => {
    try {
      // Connection-shape guard the auth middleware cannot make (drop if the
      // service has exactly one connection kind).
      if (!req.userSession?.{{tokenField}}) {
        res.status(403).json({ error: '{{ProviderName}} connection required for REST. Connect via the dashboard.' });
        return;
      }

      // Required query params are validated before any upstream call.
      const {{requiredQueryParam}} = qstr(req.query.{{requiredQueryParam}});
      if (!{{requiredQueryParam}}) {
        res.status(400).json({ error: '{{requiredQueryParam}} query parameter is required' });
        return;
      }

      const {{paramName}} = req.params.{{paramName}} as string;
      const limit = qint(req.query.limit, {{defaultLimit}}, { max: {{maxLimit}} });

      const { {{ClientClass}} } = await import('../{{provider}}/apiHelpers.js');
      const client = new {{ClientClass}}(req.userSession.{{tokenField}});
      const result = await client.{{clientMethod}}({{clientArgs}});

      res.json(result);
    } catch (err) {
      sendUpstreamError(res, err, { notFound: '{{ResourceName}} not found', fallback: 'Failed to {{verbPhrase}}' });
    }
  });

