# Docker ignore file for Railway deployment.
# The Dockerfile copies only package*.json, tsconfig.json, src and public, so
# this list is the second line of defence: it keeps local state and secrets out
# of the build context altogether.

node_modules
npm-debug.log
.git
.gitignore
*.md
!README.md
tests
*.test.ts
*.spec.ts
.DS_Store
*.mp4
docs
pages
assets
.repomix
repomix-output.txt.xml

# Local state and secrets: the file-fallback stores (users, connection tokens,
# catalog secrets) live in data/, and the stdio auth path writes token.json.
data
.env
.env.*
credentials.json
token.json
*.pem

# Build output and tooling that never belongs in the image. Patterns match from
# the context root only, so tests under src/ need their own entries (tsc would
# otherwise compile them into dist/__tests__ in the runtime image).
dist
src/__tests__
**/*.test.ts
coverage
e2e
.claude
.github
.planning
scripts
