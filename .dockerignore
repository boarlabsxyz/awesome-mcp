# Docker ignore file for Railway deployment
node_modules
npm-debug.log
.git
.gitignore
*.md
!README.md
.env
.env.*
tests
*.test.ts
*.spec.ts
.DS_Store
# Root-level only. NOTE: .dockerignore patterns match the FULL relative path
# and `*` does not cross `/`, so these do NOT touch public/docs/**.
/*.mp4
/docs
/pages
/assets

# The public docs site and its screencasts MUST ship in the image.
!public/docs
!public/docs/**

# Dev-only symlink created by `npm run dev:docs`; the image gets dist/public.
src/public
.repomix
repomix-output.txt.xml

# Don't ignore credentials for deployment (but use env vars instead!)
# credentials.json
# token.json
