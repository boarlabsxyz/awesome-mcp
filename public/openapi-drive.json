{
  "openapi": "3.0.0",
  "info": {
    "title": "Google Drive MCP REST API",
    "description": "REST API for managing Google Drive files and folders. For use with ChatGPT Custom Actions.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://awesome-mcp.xyz",
      "description": "Production server"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/v1/drive/files/{fileId}": {
      "get": {
        "operationId": "getFileInfo",
        "summary": "Get file info",
        "description": "Gets metadata for a specific file in Google Drive.",
        "parameters": [
          {
            "name": "fileId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The file ID"
          }
        ],
        "responses": {
          "200": {
            "description": "File info retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/File"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "File not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteFile",
        "summary": "Delete a file",
        "description": "Deletes a file from Google Drive. By default moves to trash unless permanent is true.",
        "parameters": [
          {
            "name": "fileId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The file ID to delete"
          },
          {
            "name": "permanent",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            },
            "description": "Whether to permanently delete the file instead of moving to trash"
          }
        ],
        "responses": {
          "200": {
            "description": "File deleted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "File not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/drive/files/{fileId}/copy": {
      "post": {
        "operationId": "copyFile",
        "summary": "Copy a file",
        "description": "Creates a copy of a file in Google Drive.",
        "parameters": [
          {
            "name": "fileId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The file ID to copy"
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "newName": {
                    "type": "string",
                    "description": "Name for the copied file. Defaults to 'Copy of <original name>'."
                  },
                  "parentFolderId": {
                    "type": "string",
                    "description": "Folder ID to place the copy in. Defaults to the same folder as the original."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "File copied successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/File"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "File not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/drive/folders/{folderId}/contents": {
      "get": {
        "operationId": "listFolderContents",
        "summary": "List folder contents",
        "description": "Lists files and subfolders within a specified folder.",
        "parameters": [
          {
            "name": "folderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The folder ID (use 'root' for the root folder)"
          },
          {
            "name": "maxResults",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 50,
              "minimum": 1,
              "maximum": 1000
            },
            "description": "Maximum number of items to return"
          },
          {
            "name": "pageToken",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "nextPageToken from the previous page."
          }
        ],
        "responses": {
          "200": {
            "description": "Folder contents retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "folderId": {
                      "type": "string"
                    },
                    "files": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/File"
                      }
                    },
                    "nextPageToken": {
                      "type": "string",
                      "nullable": true,
                      "description": "Non-null when more items remain."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Folder not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/drive/folders": {
      "post": {
        "operationId": "createFolder",
        "summary": "Create a folder",
        "description": "Creates a new folder in Google Drive.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Name of the new folder"
                  },
                  "parentFolderId": {
                    "type": "string",
                    "description": "Parent folder ID. Defaults to the root folder."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Folder created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/File"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - missing required fields",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/drive/files": {
      "get": {
        "operationId": "searchDriveFiles",
        "summary": "Search all of Drive by name or content, or list recent files",
        "description": "Any file type and folder. Omit q for the most recently modified files. Paginated with nextPageToken; incompleteSearch true means Drive skipped some locations. A fullText search is ordered by relevance.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "description": "Text to look for. Omit to list the most recently modified files."
          },
          {
            "name": "searchIn",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "name",
                "content",
                "both"
              ],
              "default": "both"
            },
            "description": "Match the query against file names, file content, or both."
          },
          {
            "name": "mimeType",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Optional type filter: document, spreadsheet, presentation, folder, form, pdf, or any MIME type (e.g. \"image/png\")."
          },
          {
            "name": "modifiedAfter",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Only files modified after this RFC 3339 time, e.g. \"2026-11-01T00:00:00Z\"."
          },
          {
            "name": "includeTrashed",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            },
            "description": "Include files in the trash."
          },
          {
            "name": "maxResults",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            },
            "description": "Files per page (1-100)."
          },
          {
            "name": "pageToken",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "nextPageToken from a previous call, to get the next page."
          },
          {
            "name": "includeSharedDrives",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            },
            "description": "Include items from shared drives. Defaults to true."
          },
          {
            "name": "driveId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Filter to a specific shared drive ID."
          },
          {
            "name": "corpora",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "user",
                "drive",
                "allDrives",
                "domain"
              ]
            },
            "description": "Source of files: user (My Drive), drive (specific), allDrives, domain."
          }
        ],
        "responses": {
          "200": {
            "description": "Files",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "files": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          },
                          "mimeType": {
                            "type": "string"
                          },
                          "modifiedTime": {
                            "type": "string"
                          },
                          "webViewLink": {
                            "type": "string"
                          },
                          "driveId": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "nextPageToken": {
                      "type": "string",
                      "nullable": true
                    },
                    "incompleteSearch": {
                      "type": "boolean"
                    },
                    "sortedBy": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid query",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Permission denied by Google",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "uploadDriveFile",
        "summary": "Upload a file, optionally converting it to a Google Doc, Sheet or Slides",
        "description": "Body limit 5mb (about 3.7 MB of file as base64). Not idempotent. convertTo is checked against what Drive can import from sourceMimeType.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "fileName": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Name for the file in Drive, e.g. \"budget.xlsx\"."
                  },
                  "sourceMimeType": {
                    "type": "string",
                    "minLength": 1,
                    "description": "MIME type of the content, e.g. \"text/csv\", \"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet\", \"application/pdf\"."
                  },
                  "contentBase64": {
                    "type": "string",
                    "minLength": 1,
                    "description": "The file bytes, base64-encoded. Give this or textContent."
                  },
                  "textContent": {
                    "type": "string",
                    "description": "The file as UTF-8 text (CSV, Markdown, HTML, plain text). Give this or contentBase64."
                  },
                  "parentFolderId": {
                    "type": "string",
                    "description": "Folder (or shared drive) to put it in. Defaults to My Drive root."
                  },
                  "convertTo": {
                    "type": "string",
                    "enum": [
                      "document",
                      "spreadsheet",
                      "presentation"
                    ],
                    "description": "Convert into a native Google Doc, Sheet or Slides file. Checked against what Drive can import from sourceMimeType."
                  }
                },
                "required": [
                  "fileName",
                  "sourceMimeType"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Uploaded",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "file": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        },
                        "mimeType": {
                          "type": "string"
                        },
                        "modifiedTime": {
                          "type": "string"
                        },
                        "webViewLink": {
                          "type": "string"
                        },
                        "driveId": {
                          "type": "string"
                        }
                      }
                    },
                    "bytes": {
                      "type": "integer"
                    },
                    "converted": {
                      "type": "boolean",
                      "description": "true only when Drive stored it as the requested Google type."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid body, both or neither content field, over 20 MB, or a conversion Drive cannot do",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Permission denied by Google",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Parent folder not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/drive/changes": {
      "get": {
        "operationId": "listDriveChanges",
        "summary": "Follow the Drive change feed",
        "description": "Without pageToken returns startPageToken and no changes. nextPageToken means more changes now; newStartPageToken means the end of the feed, poll later with it.",
        "parameters": [
          {
            "name": "pageToken",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Token from a previous call (newStartPageToken or nextPageToken). Omit on the first call to get a starting token: changes are recorded from that moment on."
          },
          {
            "name": "maxResults",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 100
            },
            "description": "Changes per page (1-1000)."
          },
          {
            "name": "driveId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Optional shared drive ID, to follow that drive instead of My Drive."
          }
        ],
        "responses": {
          "200": {
            "description": "Changes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "changes": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "changeType": {
                            "type": "string"
                          },
                          "time": {
                            "type": "string"
                          },
                          "removed": {
                            "type": "boolean"
                          },
                          "fileId": {
                            "type": "string"
                          },
                          "file": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string"
                              },
                              "name": {
                                "type": "string"
                              },
                              "mimeType": {
                                "type": "string"
                              },
                              "modifiedTime": {
                                "type": "string"
                              },
                              "webViewLink": {
                                "type": "string"
                              },
                              "driveId": {
                                "type": "string"
                              }
                            }
                          }
                        }
                      }
                    },
                    "startPageToken": {
                      "type": "string",
                      "nullable": true
                    },
                    "nextPageToken": {
                      "type": "string",
                      "nullable": true
                    },
                    "newStartPageToken": {
                      "type": "string",
                      "nullable": true
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid query",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Permission denied by Google",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "API key obtained from the registration dashboard"
      }
    },
    "schemas": {
      "File": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the file"
          },
          "name": {
            "type": "string",
            "description": "Name of the file"
          },
          "mimeType": {
            "type": "string",
            "description": "MIME type of the file"
          },
          "size": {
            "type": "string",
            "nullable": true,
            "description": "Size of the file in bytes"
          },
          "createdTime": {
            "type": "string",
            "format": "date-time",
            "description": "When the file was created"
          },
          "modifiedTime": {
            "type": "string",
            "format": "date-time",
            "description": "When the file was last modified"
          },
          "parents": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true,
            "description": "IDs of parent folders"
          },
          "webViewLink": {
            "type": "string",
            "nullable": true,
            "description": "Link to open the file in a browser"
          },
          "owners": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true,
            "description": "Email addresses of file owners"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Error message"
          }
        }
      }
    }
  }
}
