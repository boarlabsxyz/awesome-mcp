{
  "openapi": "3.0.0",
  "info": {
    "title": "Browserbase REST API",
    "description": "REST data plane for the Browserbase connection. Operations not listed here are described by the merged public/openapi.json from the catalog.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://awesome-mcp.xyz",
      "description": "Production server"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/v1/browserbase/sessions/{sessionId}/act": {
      "post": {
        "operationId": "actOnBrowserPage",
        "summary": "Perform one plain-language action on the current page",
        "description": "Shipped on the owner request for full REST coverage of non-destructive writes. Mirrors the MCP tool `act`. It clicks and submits forms on third-party sites with no confirmation step, and the permanent dashboard API key can call it. Domain rules do not apply, as on the MCP tool: an action names no destination, so the rules bind navigate only. The sessionId comes from the path.",
        "tags": [
          "browserbase"
        ],
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The session id returned by POST /api/v1/browserbase/sessions/start."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "action": {
                    "type": "string",
                    "minLength": 1,
                    "description": "What to do on the current page, in plain language \u2014 e.g. \"click the Sign in button\", \"type hello@example.com into the email field\". One action per call."
                  }
                },
                "required": [
                  "action"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "What the page did, sanitised and size-capped.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "sessionId": {
                      "type": "string"
                    },
                    "result": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid body, or no active session for that id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "No Browserbase connection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Session not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "API key obtained from the registration dashboard"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Error message"
          }
        }
      }
    }
  }
}
