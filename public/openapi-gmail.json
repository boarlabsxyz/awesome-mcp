    "/api/v1/gmail/labels/get-or-create": {
      "post": {
        "operationId": "getOrCreateGmailLabel",
        "summary": "Find a label by name or create it",
        "description": "201 with created true when the label was made, 200 with created false when it already existed. Matches the name case-insensitively. Mirrors the MCP tool `getOrCreateLabel`.",
