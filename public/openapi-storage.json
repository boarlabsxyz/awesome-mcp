{
  "openapi": "3.0.0",
  "info": {
    "title": "Storage MCP REST API",
    "description": "REST data plane for the Storage MCP: per-user collections with enforced schemas. It exists so a script (for example in the Sandbox MCP) can read, query and bulk-write records without them crossing the LLM context window. Every request is validated with the MCP tools own Zod schemas and runs the same operations; checks the operations add beyond those schemas are stated in each operation here. Data is the callers own: a bearer reaches only the records of the user it was minted for. Writes are createCollection, insert and update; deleting records, migrating and dropping collections stay MCP-only.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/v1/storage/collections": {
      "post": {
        "operationId": "createStorageCollection",
        "summary": "Create a collection with a fixed schema",
        "description": "Admins only (ADMIN_EMAILS); others get 403. Shipped on the owner request for full REST coverage of non-destructive writes. The permanent dashboard API key can call it. Body is the createCollection tool arguments, the collection name included. Every record written later must match the schema exactly; it changes only through migrateCollection (MCP only).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "collection": {
                    "type": "string",
                    "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$",
                    "description": "Collection name: starts with a letter, then letters, digits, _ or - (max 64 chars)."
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000,
                    "description": "What this collection is for, so a later conversation knows when to use it."
                  },
                  "fields": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "enum": [
                            "string",
                            "number",
                            "integer",
                            "boolean",
                            "datetime",
                            "url",
                            "string[]",
                            "number[]",
                            "json"
                          ],
                          "description": "string, number, integer, boolean, datetime (ISO 8601), url, string[], number[], or json (any object or array, for nested data that needs no querying)."
                        },
                        "required": {
                          "type": "boolean",
                          "default": false,
                          "description": "Whether every record must carry this field."
                        },
                        "description": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 500,
                          "description": "What the field holds. Required: it is what a later conversation reads to understand the data."
                        },
                        "enum": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 200
                          },
                          "minItems": 1,
                          "maxItems": 100,
                          "description": "Allowed values. Only for string and string[] fields."
                        }
                      },
                      "required": [
                        "type",
                        "description"
                      ],
                      "additionalProperties": false
                    },
                    "description": "The collection's fields, by name. Names start with a letter and use letters, digits and _ (max 64 chars); at most 50 fields.",
                    "minProperties": 1,
                    "maxProperties": 50
                  },
                  "keyField": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64,
                    "description": "A required string, url, integer or number field that uniquely identifies a record (e.g. profileUrl). Enables getRecord/updateRecord by key and insertRecords with onConflict \"update\"."
                  },
                  "ttlDays": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 3650,
                    "description": "After this many days without an update a record reads as _stale: true, meaning re-fetch it from the source."
                  }
                },
                "required": [
                  "collection",
                  "description",
                  "fields"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Collection created; its schema",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid body, a bad field definition, a name already in use, or the collection quota reached",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Not an admin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "No database configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listStorageCollections",
        "summary": "List your storage collections with record counts and quotas",
        "description": "Name, description, schema version, field names, record count, size and last write of every collection, plus the quotas. Mirrors the MCP tool `listCollections`.",
        "tags": [
          "storage"
        ],
        "responses": {
          "200": {
            "description": "The collections and limits.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid arguments, or the request does not match the collection schema; the error says what to fix.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "This deployment has no database.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/storage/collections/{collection}": {
      "get": {
        "operationId": "describeStorageCollection",
        "summary": "Get the schema and migration history of one collection",
        "description": "Every field with its type and description, the keyField and ttlDays, record count, and the last 10 migrations. Mirrors the MCP tool `describeCollection`.",
        "tags": [
          "storage"
        ],
        "parameters": [
          {
            "name": "collection",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The collection name. GET /api/v1/storage/collections lists them."
          }
        ],
        "responses": {
          "200": {
            "description": "The collection.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid arguments, or the request does not match the collection schema; the error says what to fix.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No such collection or record.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "This deployment has no database.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/storage/collections/{collection}/records/{recordId}": {
      "get": {
        "operationId": "getStorageRecord",
        "summary": "Get one record by id or by keyField value",
        "description": "The record with its system fields (_id, _createdAt, _updatedAt, _ageDays, and _stale when the collection has ttlDays). Mirrors the MCP tool `getRecord`.",
        "tags": [
          "storage"
        ],
        "parameters": [
          {
            "name": "collection",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The collection name. GET /api/v1/storage/collections lists them."
          },
          {
            "name": "recordId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The record _id, or its keyField value with by=key (URL-encode it)."
          },
          {
            "name": "by",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "id",
                "key"
              ]
            },
            "description": "key: recordId is the keyField value rather than the _id. Default id."
          }
        ],
        "responses": {
          "200": {
            "description": "The record.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid arguments, or the request does not match the collection schema; the error says what to fix.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No such collection or record.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "This deployment has no database.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/storage/collections/{collection}/find": {
      "post": {
        "operationId": "findStorageRecords",
        "summary": "Query the records of one collection",
        "description": "A read despite the POST: the where conditions do not fit a query string. Returns total, one page of records and nextCursor; pass nextCursor back with the other arguments unchanged. Mirrors the MCP tool `findRecords`.",
        "tags": [
          "storage"
        ],
        "parameters": [
          {
            "name": "collection",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The collection name. GET /api/v1/storage/collections lists them."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "where": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "field": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 64
                        },
                        "op": {
                          "type": "string",
                          "enum": [
                            "eq",
                            "ne",
                            "gt",
                            "gte",
                            "lt",
                            "lte",
                            "in",
                            "contains",
                            "exists"
                          ]
                        },
                        "value": {
                          "description": "Compared as the field's type. in: an array. contains: a substring (string/url fields, case-insensitive) or one element (array fields). exists: true/false."
                        }
                      },
                      "required": [
                        "field",
                        "op"
                      ],
                      "additionalProperties": false
                    },
                    "maxItems": 20,
                    "description": "Conditions, all of which must hold."
                  },
                  "contains": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200,
                    "description": "Case-insensitive text search across the whole record, field names included."
                  },
                  "updatedWithinDays": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 3650,
                    "description": "Only records updated within this many days."
                  },
                  "orderBy": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64,
                    "description": "A single-value field, _updatedAt (default) or _createdAt."
                  },
                  "order": {
                    "type": "string",
                    "enum": [
                      "asc",
                      "desc"
                    ],
                    "default": "desc"
                  },
                  "limit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100,
                    "default": 25
                  },
                  "cursor": {
                    "type": "string",
                    "maxLength": 100000,
                    "description": "nextCursor from a previous call, to get the next page. Keep the other arguments unchanged."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "A page of matches.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid arguments, or the request does not match the collection schema; the error says what to fix.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No such collection or record.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "This deployment has no database.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/storage/collections/{collection}/records": {
      "post": {
        "operationId": "insertStorageRecords",
        "summary": "Insert up to 500 records, all or nothing",
        "description": "Each record must match the collection schema; one invalid record rejects the batch with the problem in each listed. With onConflict update, a record whose keyField value exists replaces that record. Answers 201 when anything was created, 200 for an upsert that only replaced. Body limit 5 MB. The permanent dashboard API key can call it, not only the 5-minute bearer. Mirrors the MCP tool `insertRecords`.",
        "tags": [
          "storage"
        ],
        "parameters": [
          {
            "name": "collection",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The collection name. GET /api/v1/storage/collections lists them."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "records": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": {}
                    },
                    "minItems": 1,
                    "maxItems": 500,
                    "description": "Records to insert, each matching the collection schema. All or nothing: one invalid record rejects the batch."
                  },
                  "onConflict": {
                    "type": "string",
                    "enum": [
                      "error",
                      "update"
                    ],
                    "default": "error",
                    "description": "When a record's keyField value already exists: \"error\" (default) rejects the batch, \"update\" replaces that record's data."
                  }
                },
                "required": [
                  "records"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Records replaced.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "201": {
            "description": "Records created.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid arguments, or the request does not match the collection schema; the error says what to fix.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No such collection or record.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "This deployment has no database.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/storage/collections/{collection}/records/{recordId}/update": {
      "post": {
        "operationId": "updateStorageRecord",
        "summary": "Update one record: set merges fields, unset removes optional ones",
        "description": "The merged record must match the schema. The record is the one the path names; an id or key in the body is ignored. The permanent dashboard API key can call it, not only the 5-minute bearer. Mirrors the MCP tool `updateRecord`.",
        "tags": [
          "storage"
        ],
        "parameters": [
          {
            "name": "collection",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The collection name. GET /api/v1/storage/collections lists them."
          },
          {
            "name": "recordId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The record _id, or its keyField value with by=key (URL-encode it)."
          },
          {
            "name": "by",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "id",
                "key"
              ]
            },
            "description": "key: recordId is the keyField value rather than the _id. Default id."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "set": {
                    "type": "object",
                    "additionalProperties": {},
                    "description": "Fields to set, merged over the current record. The result must match the schema."
                  },
                  "unset": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64
                    },
                    "maxItems": 50,
                    "description": "Optional fields to remove."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated record.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid arguments, or the request does not match the collection schema; the error says what to fix.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No such collection or record.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "This deployment has no database.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "A 5-minute bearer from the mintRestBearerForCurl MCP tool, or the dashboard API key."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "issues": {
            "type": "object"
          }
        },
        "required": [
          "error"
        ]
      }
    }
  }
}
